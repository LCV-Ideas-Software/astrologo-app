{
  "name": "astrologo-frontend",
  "version": "2.22.2",
  "description": "Astrólogo — gerador de mapas astrais e análises esotéricas via integração Gemini AI. React 19 + Vite 8 sobre Cloudflare Pages com D1 backing store.",
  "license": "AGPL-3.0-or-later",
  "author": "LCV Ideas & Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCV-Ideas-Software/astrologo-app.git"
  },
  "homepage": "https://github.com/LCV-Ideas-Software/astrologo-app#readme",
  "bugs": {
    "url": "https://github.com/LCV-Ideas-Software/astrologo-app/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:swiss-wasm": "node scripts/prepare-swiss-wasm.mjs",
    "dev": "npm run prepare:swiss-wasm && vite",
    "build": "npm run prepare:swiss-wasm && tsc -b && vite build",
    "build:functions": "npm run prepare:swiss-wasm && wrangler pages functions build --outdir=.wrangler/functions-build-check",
    "lint": "eslint .",
    "biome": "biome check .",
    "biome:write": "biome check --write .",
    "security:tracked-executables": "node scripts/check-tracked-executables.mjs",
    "test": "npm run prepare:swiss-wasm && vitest run",
    "preview": "vite preview",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@js-temporal/polyfill": "0.5.1",
    "@tailwindcss/vite": "^4.3.2",
    "astronomy-engine": "2.1.19",
    "d3-geo": "3.1.1",
    "dompurify": "^3.4.11",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.5",
    "tailwindcss": "^4.3.2",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@eslint/js": "^10.0.1",
    "@fusionstrings/swiss-eph": "0.1.1",
    "@types/d3-geo": "3.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "@fusionstrings/swiss-eph": {
      "undici": "6.27.0"
    },
    "vite": "$vite",
    "protobufjs": "7.6.3",
    "@babel/core": "7.29.6"
  }
}
